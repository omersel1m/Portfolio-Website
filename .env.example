# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the deployed site, used for canonical links, the sitemap and
# social previews. Optional on Vercel, which provides the production URL itself.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# SMTP account the contact form sends through. With Gmail, create an App
# Password (Google Account > Security > 2-Step Verification > App passwords)
# and use it as SMTP_PASS. Never use your real Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact form messages are delivered. Defaults to the email in content/site.ts.
CONTACT_TO_EMAIL=
